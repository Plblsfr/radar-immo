# ── Serveur
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Mettre true derrière un reverse proxy (IP réelle dans les logs)
TRUST_PROXY=false

# ── PostgreSQL : la MÊME base que le backend principal, dans un schéma dédié
DATABASE_URL=postgres://radar_immo:motdepasse@localhost:5432/app
DB_SCHEMA=radar_immo
DB_POOL_MAX=10
DB_SSL=false
# Applique les migrations au démarrage (sinon : npm run migrate)
MIGRATE_ON_START=true

# ── Authentification déléguée au backend d'authentification
# Route GET appelée avec le jeton du client. 2xx = valide, 4xx = refusé, 5xx = indisponible.
AUTH_VERIFY_URL=https://auth.example.fr/api/auth/me
# En-tête dans lequel le jeton est transmis, et son préfixe (vide pour le jeton brut)
AUTH_HEADER_NAME=Authorization
AUTH_HEADER_PREFIX="Bearer "
AUTH_TIMEOUT_MS=3000
# Durée pendant laquelle un jeton validé n'est pas revérifié
AUTH_CACHE_TTL_MS=30000
# Où lire l'identifiant utilisateur dans la réponse 2xx (le premier trouvé gagne)
AUTH_USER_ID_PATHS=id,userId,user_id,sub,user.id,data.id
# Sinon, utiliser le claim « sub » si le jeton est un JWT
AUTH_USER_ID_FROM_JWT=true

# ── CORS
# Origines du front-end, séparées par des virgules
CORS_ORIGINS=https://app.example.fr
# Autoriser les extensions de navigateur (chrome-extension://, moz-extension://)
CORS_ALLOW_EXTENSIONS=true
# Facultatif : restreindre aux identifiants d'extension Chrome publiés
CORS_EXTENSION_IDS=

# ── Limites
BODY_LIMIT_BYTES=5242880
LISTING_MAX_BYTES=65536
SETTINGS_MAX_BYTES=262144
SYNC_PUSH_MAX=500
SYNC_PULL_MAX=500
