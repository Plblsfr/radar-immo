{
  "manifest_version": 3,
  "name": "Radar Immo — assistant d'achat immobilier",
  "short_name": "Radar Immo",
  "version": "1.3.0",
  "description": "Note chaque annonce selon tes critères (budget, DPE, quartiers bannis…), suit les prix et repère les doublons entre Leboncoin, SeLoger, PAP, Bien'ici…",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Radar Immo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/radar.js",
      "lib/cloud.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://*.leboncoin.fr/*",
    "https://*.seloger.com/*",
    "https://*.pap.fr/*",
    "https://*.bienici.com/*",
    "https://*.logic-immo.com/*",
    "https://*.ouestfrance-immo.com/*",
    "https://immobilier.lefigaro.fr/*",
    "https://*.paruvendu.fr/*",
    "https://immobilier.notaires.fr/*",
    "https://*.orpi.com/*",
    "https://*.century21.fr/*",
    "https://*.laforet.com/*",
    "https://*.guy-hoquet.com/*",
    "https://*.iadfrance.fr/*",
    "https://*.safti.fr/*",
    "https://*.capifrance.fr/*",
    "https://*.avendrealouer.fr/*",
    "https://*.superimmo.com/*",
    "https://*.entreparticuliers.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.leboncoin.fr/*",
        "https://*.seloger.com/*",
        "https://*.pap.fr/*",
        "https://*.bienici.com/*",
        "https://*.logic-immo.com/*",
        "https://*.ouestfrance-immo.com/*",
        "https://immobilier.lefigaro.fr/*",
        "https://*.paruvendu.fr/*",
        "https://immobilier.notaires.fr/*",
        "https://*.orpi.com/*",
        "https://*.century21.fr/*",
        "https://*.laforet.com/*",
        "https://*.guy-hoquet.com/*",
        "https://*.iadfrance.fr/*",
        "https://*.safti.fr/*",
        "https://*.capifrance.fr/*",
        "https://*.avendrealouer.fr/*",
        "https://*.superimmo.com/*",
        "https://*.entreparticuliers.com/*"
      ],
      "js": [
        "lib/radar.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "auth/callback.html"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "radar-immo@plbls.fr",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}